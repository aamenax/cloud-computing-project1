# ==========================================
# AWS Credentials & Lex Bot Configuration
# ==========================================
# If MOCK_AWS=true, the app simulates AWS Lex responses locally 
# so you can test all UI animations and flow without AWS credentials!
# Change MOCK_AWS=false once you set up your AWS Lex bot.
MOCK_AWS=false

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1

# Amazon Lex V2 Bot IDs (Found in AWS Lex Console)
LEX_BOT_ID=YOUR_LEX_BOT_ID
LEX_BOT_ALIAS_ID=TSTALIASID
LEX_LOCALE_ID=en_US

PORT=5000
